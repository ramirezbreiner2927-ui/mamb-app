// prisma/schema.prisma
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  USER
}

enum EventType {
  VISITA_GUIADA
  TALLER
  ENCUENTRO
  EVENTO_RECURRENTE
}

enum ProductCategory {
  CAMISAS
  TOTEBAGS
  TAZAS
  LIBROS
  PRINTS
  ACCESORIOS
}

model User {
  id         Int      @id @default(autoincrement())
  name       String
  email      String   @unique
  password   String
  role       Role     @default(USER)
  createdAt  DateTime @default(now()) @map("created_at")
  images     Image[]

  @@map("users")
}

model Evento {
  id          Int       @id @default(autoincrement())
  title       String
  description String?
  date        DateTime
  type        EventType
  recurrence  String?   // "weekly", "monthly" — solo para recurrentes
  price       Int       @default(10000)
  capacity    Int?
  imageUrl    String?   @map("image_url")
  isActive    Boolean   @default(true) @map("is_active")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  @@map("eventos")
}

model Horario {
  id        Int      @id @default(autoincrement())
  day       String   // "Lunes", "Martes", etc.
  dayOrder  Int      @map("day_order") // 1-7 para ordenar
  openTime  String   @map("open_time")  // "09:00"
  closeTime String   @map("close_time") // "18:00"
  isClosed  Boolean  @default(false) @map("is_closed")
  basePrice Int      @default(10000) @map("base_price")

  @@map("horarios")
}

model Producto {
  id          Int             @id @default(autoincrement())
  name        String
  description String?
  price       Int
  stock       Int             @default(0)
  category    ProductCategory
  imageUrl    String?         @map("image_url")
  isActive    Boolean         @default(true) @map("is_active")
  createdAt   DateTime        @default(now()) @map("created_at")
  updatedAt   DateTime        @updatedAt @map("updated_at")

  @@map("productos")
}

model Image {
  id           Int      @id @default(autoincrement())
  userId       Int      @map("user_id")
  user         User     @relation(fields: [userId], references: [id])
  originalUrl  String   @map("original_url")
  generatedUrl String?  @map("generated_url")
  artworkName  String?  @map("artwork_name")
  authorName   String?  @map("author_name")
  authorAge    Int?     @map("author_age")
  isPublic     Boolean  @default(true) @map("is_public")
  createdAt    DateTime @default(now()) @map("created_at")

  @@map("images")
}
